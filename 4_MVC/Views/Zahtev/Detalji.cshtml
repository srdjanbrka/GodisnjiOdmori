@model GodisnjiOdmori.MVC.ModeliPrikaza.ZahtevDetaljiModel
@{ ViewBag.Title="Zahtev #"+Model.ZahtevID; }
<div class="heading"><div><p class="eyebrow">DOKUMENT #@Model.ZahtevID</p><h1>Zahtev za korišćenje godišnjeg odmora</h1></div><button class="secondary no-print" onclick="window.print()">Štampaj</button></div>
<section class="card">
<dl class="grid document-summary"><div>
<dt>Zaposleni</dt><dd>@Model.ImePrezime</dd>
<dt>Sektor / radno mesto</dt><dd>@Model.Sektor / @Model.RadnoMesto</dd>
<dt>Period korišćenja odmora</dt><dd>@Model.DatumOd.ToString("dd.MM.yyyy.") – @Model.DatumDo.ToString("dd.MM.yyyy.")</dd>
</div><div>
<dt>Datum podnošenja</dt><dd>@Model.DatumPodnosenja.ToString("dd.MM.yyyy. HH:mm")</dd>
<dt>Status</dt><dd>@Model.Status</dd>
<dt>Broj radnih dana</dt><dd>@Model.BrojRadnihDana</dd>
</div></dl>
<p class="print-only">Potpis zaposlenog: ____________________ &nbsp; Potpis odgovornog lica: ____________________</p>
<div class="actions no-print">
@if(User.IsInRole("Kadrovska") && (Model.Status=="Podnet" || Model.Status=="Na čekanju")) {
using(Html.BeginForm("Odobri","Zahtev",FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ZahtevID" /><input type="hidden" name="verzija" value="@Model.Verzija" /><button type="submit">Proveri i odobri</button> }
}
@if(User.IsInRole("Kadrovska") && Model.Status!="Odbijen") {
using(Html.BeginForm("Odbij","Zahtev",FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ZahtevID" /><input type="hidden" name="verzija" value="@Model.Verzija" /><button class="secondary" type="submit">Odbij zahtev</button> }
}
@if(User.IsInRole("Zaposleni") && Model.Status!="Odobren") {
<a class="button secondary" href="@Url.Action("Izmeni",new{id=Model.ZahtevID})">Izmeni</a>
using(Html.BeginForm("Obrisi","Zahtev",FormMethod.Post,new{onsubmit="return confirm('Trajno obrisati ovaj zahtev?');"})) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ZahtevID" /><input type="hidden" name="verzija" value="@Model.Verzija" /><button class="danger" type="submit">Obriši</button> }
}
<a href="@Url.Action("Index")">Nazad</a>
</div>
</section>
