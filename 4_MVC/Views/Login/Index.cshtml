@model GodisnjiOdmori.MVC.ModeliPrikaza.PrijavaModel
@{ ViewBag.Title="Prijava"; }
<section class="card login"><p class="eyebrow">GODIŠNJI ODMORI</p><h1>Prijava na sistem</h1>
<p>Zaposleni podnosi zahtev, a kadrovska služba ga obrađuje.</p>
@using(Html.BeginForm("Index","Login",FormMethod.Post)) {
    @Html.AntiForgeryToken() @Html.ValidationSummary(false)
    @Html.LabelFor(m=>m.KorisnickoIme) @Html.TextBoxFor(m=>m.KorisnickoIme,new{autocomplete="username",maxlength="50"})
    @Html.LabelFor(m=>m.Lozinka) @Html.PasswordFor(m=>m.Lozinka,new{autocomplete="current-password",maxlength="200"})
    <button type="submit">Prijavi se</button>
}
<div class="demo"><strong>Demo nalozi</strong><br />Zaposleni: <code>zaposleni</code> / <code>ZaposleniDemo2026!</code><br />Kadrovska: <code>kadrovska</code> / <code>OdmorDemo2026!</code></div>
</section>
